                "{{roomId}}"
              ]
            }
          }
        },
        {
          "name": "Update the room price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));",
