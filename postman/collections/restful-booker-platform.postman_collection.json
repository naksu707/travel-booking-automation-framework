          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Overlapping dates are refused with 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomid\": {{bookingRoomId}},\n  \"firstname\": \"{{guestFirstname}}\",\n  \"lastname\": \"Ospina\",\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{overlapCheckin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"email\": \"guest@example.com\",\n  \"phone\": \"01234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
