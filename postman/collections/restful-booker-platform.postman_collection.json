        {
          "name": "BUG-002 \u00b7 A booking in the past is rejected",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A stay that ended a week ago",
                  "const iso = d => d.toISOString().slice(0, 10);",
                  "const checkin = new Date(); checkin.setDate(checkin.getDate() - 10);",
                  "const checkout = new Date(); checkout.setDate(checkout.getDate() - 7);",
                  "pm.environment.set(\"pastCheckin\", iso(checkin));",
                  "pm.environment.set(\"pastCheckout\", iso(checkout));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// BUG-002: the API accepts the booking with 201 Created",
                  "pm.test(\"A booking in the past is rejected (400 or 409)\", () => pm.expect(pm.response.code).to.be.oneOf([400, 409]));",
                  "",
                  "// If it was accepted, delete it so the demo is left clean",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"baseUrl\") + \"/api/booking/\" + pm.response.json().bookingid,",
                  "        method: \"DELETE\",",
                  "        header: { Cookie: \"token=\" + pm.environment.get(\"token\") }",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
