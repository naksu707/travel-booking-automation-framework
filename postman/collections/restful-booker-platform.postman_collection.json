              "mode": "raw",
              "raw": "{\n  \"roomName\": \"{{roomName}}\",\n  \"type\": \"{{roomType}}\",\n  \"accessible\": true,\n  \"image\": \"/images/room2.jpg\",\n  \"description\": \"Room created by the Postman collection.\",\n  \"features\": [\"WiFi\", \"TV\"],\n  \"roomPrice\": 199\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a room without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));",
                  "",
                  "// If a room was created anyway, delete it so the demo is left clean",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"baseUrl\") + \"/api/room/\" + pm.response.json().roomid,",
                  "        method: \"DELETE\",",
                  "        header: { Cookie: \"token=\" + pm.environment.get(\"token\") }",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/room/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "room",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"{{roomName}}\",\n  \"type\": \"{{roomType}}\",\n  \"accessible\": true,\n  \"image\": \"/images/room2.jpg\",\n  \"description\": \"Room created by the Postman collection.\",\n  \"features\": [\"WiFi\", \"TV\"],\n  \"roomPrice\": {{roomPrice}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sent with cookies disabled (protocolProfileBehavior.disableCookies), so the token saved by the login is not sent."
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          }
