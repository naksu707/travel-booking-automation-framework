    {
      "name": "Booking",
      "description": "A guest books a room: dates, double booking, date rules and guest details. Uses the token saved by Auth.",
      "item": [
        {
          "name": "Create a room for the bookings",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Each run books its own new room, so the dates are always free",
                  "pm.environment.set(\"bookingRoomName\", \"BK\" + Math.floor(1000 + Math.random() * 9000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"bookingRoomId\", pm.response.json().roomid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/room/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "room",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"{{bookingRoomName}}\",\n  \"type\": \"Double\",\n  \"accessible\": false,\n  \"image\": \"/images/room2.jpg\",\n  \"description\": \"Room for the booking checks of the Postman collection.\",\n  \"features\": [\"WiFi\"],\n  \"roomPrice\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Book the room as a guest",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const iso = d => d.toISOString().slice(0, 10);",
                  "",
                  "// A stay of 3 nights between 2 and 23 months ahead",
                  "const checkin = new Date();",
                  "checkin.setDate(checkin.getDate() + 60 + Math.floor(Math.random() * 640));",
                  "const checkout = new Date(checkin);",
                  "checkout.setDate(checkout.getDate() + 3);",
                  "const overlap = new Date(checkin);",
                  "overlap.setDate(overlap.getDate() + 1);",
                  "",
                  "pm.environment.set(\"checkin\", iso(checkin));",
                  "pm.environment.set(\"checkout\", iso(checkout));",
                  "pm.environment.set(\"overlapCheckin\", iso(overlap));",
                  "pm.environment.set(\"guestFirstname\", [\"Maria\", \"Lucas\", \"Sofia\", \"Mateo\"][Math.floor(Math.random() * 4)]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const created = pm.response.json();",
                  "pm.environment.set(\"bookingId\", created.bookingid);",
                  "",
                  "pm.test(\"The booking is returned with an id and the guest's data\", () => {",
                  "    pm.expect(created.bookingid).to.be.above(0);",
                  "    pm.expect(created.booking.roomid).to.eql(Number(pm.environment.get(\"bookingRoomId\")));",
                  "    pm.expect(created.booking.firstname).to.eql(pm.environment.get(\"guestFirstname\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomid\": {{bookingRoomId}},\n  \"firstname\": \"{{guestFirstname}}\",\n  \"lastname\": \"Ospina\",\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"email\": \"guest@example.com\",\n  \"phone\": \"01234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Admin reads the booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"It is the guest's booking\", () => {",
                  "    pm.expect(pm.response.json().firstname).to.eql(pm.environment.get(\"guestFirstname\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
